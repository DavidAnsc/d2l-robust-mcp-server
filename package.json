{
  "name": "d2l-robust-mcp-server",
  "version": "1.3.0",
  "description": "Read-only MCP server for D2L Brightspace: stdio or HTTP, headless-friendly login, clear session-expiry errors",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "d2l-mcp": "dist/index.js",
    "d2l-mcp-auth": "dist/auth-cli.js",
    "d2l-mcp-sync": "dist/sync-cli.js"
  },
  "files": [
    "dist",
    "deploy",
    "docs",
    "scripts",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "brightspace",
    "claude",
    "d2l",
    "education",
    "lms",
    "mcp",
    "model-context-protocol",
    "raspberry-pi",
    "streamable-http"
  ],
  "author": "Bence Redmond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidAnsc/d2l-robust-mcp-server.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "auth": "node dist/auth-cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "D2L_INTEGRATION_TESTS=true vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/install-browser.mjs",
    "sync": "node dist/sync-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.40.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.14",
    "typescript": "^5.3.0",
    "vitest": "^4.0.14"
  },
  "contributors": [
    "DavidAnsc (https://github.com/DavidAnsc)"
  ],
  "homepage": "https://github.com/DavidAnsc/d2l-robust-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/DavidAnsc/d2l-robust-mcp-server/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
