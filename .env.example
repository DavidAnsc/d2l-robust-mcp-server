# Copy to .env (never commit it). Only D2L_HOST is needed for most people.

# Your school's Brightspace host, without https:// (e.g. learn.example.edu)
D2L_HOST=

# Optional: default course, so tools can be called without orgUnitId
#D2L_COURSE_ID=

# Optional: time zone for dates in tool output (IANA name). Defaults to this machine's zone.
#D2L_TIMEZONE=America/Toronto

# HTTP mode only (d2l-mcp --http). Generate a token with: openssl rand -hex 32
#D2L_HTTP_TOKEN=
