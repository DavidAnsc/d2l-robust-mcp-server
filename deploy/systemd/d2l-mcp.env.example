# /etc/d2l-mcp.env  (sudo chmod 600 /etc/d2l-mcp.env)

# Your school's Brightspace host name, without https://
D2L_HOST=your-school.brightspace.com
# Optional default course
#D2L_COURSE_ID=

# Long random secret clients must send. Generate one with: openssl rand -hex 32
D2L_HTTP_TOKEN=

# Defaults, shown for reference:
#D2L_HTTP_HOST=127.0.0.1
#D2L_HTTP_PORT=3000
#D2L_HTTP_ENABLE_DOWNLOAD=false
#D2L_DOWNLOAD_DIR=
#D2L_SESSION_PATH=
