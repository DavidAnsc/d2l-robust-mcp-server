# /etc/d2l-mcp.env  (sudo chmod 600 /etc/d2l-mcp.env)

# Your school's Brightspace host name, without https://
D2L_HOST=your-school.brightspace.com
# Optional default course
#D2L_COURSE_ID=
# Time zone for dates in tool output, e.g. America/Toronto (the Pi is often set to UTC)
#D2L_TIMEZONE=

# Long random secret clients must send. Generate one with: openssl rand -hex 32
D2L_HTTP_TOKEN=

# Get a phone notification when the login expires (install the ntfy app and subscribe to
# the same topic; pick a long, unguessable topic name):
# Automatic Microsoft sign-in when the D2L session ends (see README, "Automatic login").
# Keep this file owner-only (chmod 600). Or put the password alone in a file and use
# D2L_PASSWORD_FILE instead of D2L_PASSWORD.
#D2L_USERNAME=12345abc@yourboard.ca
#D2L_PASSWORD=
#D2L_PASSWORD_FILE=/etc/d2l-mcp.password

#D2L_NOTIFY_URL=https://ntfy.sh/d2l-<random-words>

# Defaults, shown for reference:
#D2L_HTTP_HOST=127.0.0.1
#D2L_HTTP_PORT=3000
#D2L_HTTP_ENABLE_DOWNLOAD=false
#D2L_DOWNLOAD_DIR=
#D2L_SESSION_PATH=
#D2L_HTTP_ALLOW_SESSION_PUSH=true   # accept d2l-mcp-auth --push from your laptop
#D2L_MAX_FILE_MB=50                 # largest file read_file will fetch
#D2L_BROWSER_PATH=                  # e.g. /usr/bin/chromium, instead of Playwright's own

# OAuth sign-in for claude.ai custom connectors (needs a public HTTPS address, e.g. Tailscale Funnel):
#D2L_OAUTH=true
#D2L_PUBLIC_URL=https://raspberrypi.tail1234.ts.net
# Only these courses count as "active" (comma-separated orgUnitIds), if the date rules guess wrong:
#D2L_ACTIVE_COURSES=
# Text cache and OCR:
#D2L_CACHE_DIR=            # default ~/.d2l-mcp-cache; D2L_CACHE=off to disable
#D2L_CACHE_MAX_MB=200
#D2L_OCR_MAX_PAGES=40      # D2L_OCR=off to disable
#D2L_SYNC_DIR=             # where d2l-mcp-sync writes; default ~/d2l-courses
